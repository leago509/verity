POSTGRES_USER=verity
POSTGRES_PASSWORD=verity
POSTGRES_DB=verity

# Used to sign login tokens. Change this to a long random string outside local dev.
SECRET_KEY=dev-only-change-me

# Frontend addresses allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Largest recording the API accepts, in MB
MAX_UPLOAD_MB=500

# --- Google Meet integration ---
# Frontend address the browser returns to after connecting Google
FRONTEND_URL=http://localhost:5173
# From Google Cloud Console > APIs & Services > Credentials (OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google-meet/callback
# Encrypts stored Google refresh tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Optional: instant notifications via Pub/Sub. Leave empty to rely on polling every 10 min.
GOOGLE_PUBSUB_TOPIC=
PUBSUB_VERIFY=true
PUBSUB_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=
